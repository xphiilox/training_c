{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build active file",
      "type": "shell",
      "command": "mkdir -p build && gcc -std=c17 -Wall -Wextra -Wpedantic -g '${file}' -o 'build/${fileBasenameNoExtension}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
